# Copy to src/.env (never commit .env). Every setting is optional — defaults run fully offline.

# Where the SQLite database, audit.jsonl ledger mirror and generated packets live
PRAMAAN_HOME=./runtime

# Web dashboard / REST API / MCP-over-HTTP server
APP_HOST=127.0.0.1
APP_PORT=8000
# Hosts allowed to call the /mcp endpoint (DNS-rebinding protection)
PRAMAAN_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
# Link printed in MCP tool results (e.g. behind a reverse proxy)
# PRAMAAN_PUBLIC_URL=http://127.0.0.1:8000
# Actor name written to the ledger for MCP tool calls
PRAMAAN_MCP_ACTOR=mcp-client

# Optional privacy list: SHA-256 hashes (one per line) of case-specific protected terms, e.g. a victim's name.
# Create with: python -c "from pramaan.privacy import hash_term; print(hash_term('Full Name'))" >> runtime/protected_terms.sha256
# PRAMAAN_PROTECTED_TERMS=./runtime/protected_terms.sha256

# Optional IBM watsonx.ai layer (Granite). "none" = deterministic offline engine only.
PRAMAAN_LLM_PROVIDER=none
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# WATSONX_SPACE_ID=
WATSONX_MODEL_ID=ibm/granite-4-h-small
